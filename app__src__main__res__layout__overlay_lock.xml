<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="56dp"
    android:paddingEnd="32dp"
    android:paddingBottom="32dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_lock" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/lock_title"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/lock_message"
        android:textColor="@color/lock_text_dim"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:letterSpacing="0.3"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvLockError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="20dp"
        android:textColor="@color/lock_error"
        android:textSize="14sp" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="3">

        <Button android:id="@+id/k1" style="@style/LockKey" android:text="1" />
        <Button android:id="@+id/k2" style="@style/LockKey" android:text="2" />
        <Button android:id="@+id/k3" style="@style/LockKey" android:text="3" />
        <Button android:id="@+id/k4" style="@style/LockKey" android:text="4" />
        <Button android:id="@+id/k5" style="@style/LockKey" android:text="5" />
        <Button android:id="@+id/k6" style="@style/LockKey" android:text="6" />
        <Button android:id="@+id/k7" style="@style/LockKey" android:text="7" />
        <Button android:id="@+id/k8" style="@style/LockKey" android:text="8" />
        <Button android:id="@+id/k9" style="@style/LockKey" android:text="9" />
        <Button android:id="@+id/kDel" style="@style/LockKey" android:text="@string/key_del" />
        <Button android:id="@+id/k0" style="@style/LockKey" android:text="0" />
        <Button android:id="@+id/kOk" style="@style/LockKey" android:text="@string/key_ok" />
    </GridLayout>

    <Button
        android:id="@+id/btnBiometric"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/lock_biometric"
        android:textColor="@android:color/white" />
</LinearLayout>
